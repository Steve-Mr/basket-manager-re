<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="40"
    android:versionName="40"
    package="com.blank.bm15pro"
    platformBuildVersionCode="21"
    platformBuildVersionName="5.0.1-1624448">
    <uses-sdk
        android:minSdkVersion="16"
        android:targetSdkVersion="21"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <application
        android:theme="@style/AppTheme"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="true">
        <activity
            android:label="@string/app_name"
            android:name="com.blank.bm15.activity.MainActivity"
            android:configChanges="screenSize|orientation|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:label="@string/select_team_title"
            android:name="com.blank.bm15.activity.SelectTeamActivity"
            android:configChanges="screenSize|orientation|keyboardHidden"
            android:parentActivityName=".activity.MainActivity"/>
        <activity
            android:label="@string/app_name"
            android:name="com.blank.bm15.activity.HomeActivity"
            android:configChanges="screenSize|orientation|keyboardHidden"
            android:parentActivityName=".activity.HomeActivity"/>
    </application>
</manifest>
